# Copy to jasper.local.properties (gitignored) and fill values from your Jasper account.
# Never commit jasper.local.properties.
#
# Base URL is fixed in app code to the panel value: https://api.yjs.im
# Paths below must match Jasper's OpenAI-compatible API surface from the Jasper console/docs.
# Confirm model id in Jasper Model Square before shipping.

# Required: API key from Jasper console (sk-...)
jasper.api.key=

# Required: exact model id from GET /v1/models for your key / Model Square
# Example ids observed for a DeepSeek group: deepseek-v4.1-flash, deepseek-v4.1-flash-req
jasper.model.id=

# Chat completions path relative to https://api.yjs.im
# Typical OpenAI-compatible gateways use /v1/chat/completions — confirm in Jasper docs/console.
jasper.chat.path=/v1/chat/completions

# Optional models listing path (unused by chat-only UI; kept for diagnostics)
jasper.models.path=/v1/models
